diff --git a/lib/core/voice/reply_extractor.dart b/lib/core/voice/reply_extractor.dart
new file mode 100644
index 0000000..2a15595
--- /dev/null
+++ b/lib/core/voice/reply_extractor.dart
@@ -0,0 +1,129 @@
+/// Lấy câu trả lời của một agent (Claude Code, Codex, ...) ra khỏi màn hình
+/// terminal, để đọc thành tiếng.
+///
+/// Thuần Dart, không phụ thuộc Flutter, để test được bằng `flutter test`.
+///
+/// Cách làm: tìm dòng có câu lệnh vừa gửi (agent luôn in lại tin nhắn của
+/// người dùng, ví dụ `> sửa lỗi build` hoặc `› sửa lỗi build`), lấy các dòng
+/// phía sau cho tới ô nhập liệu tiếp theo, rồi bỏ những thứ không nên đọc:
+/// khung viền, spinner, lời gọi tool, kết quả tool, dòng gợi ý phím tắt.
+library;
+
+/// Agent còn đang chạy hay không. Cả Claude Code lẫn Codex đều hiện
+/// "esc to interrupt" trong lúc làm việc.
+bool agentLooksBusy(List<String> screenTail) {
+  for (final line in screenTail) {
+    final l = line.toLowerCase();
+    if (l.contains('to interrupt')) return true;
+  }
+  return false;
+}
+
+/// Trả về đoạn văn cần đọc, hoặc chuỗi rỗng nếu không tìm thấy.
+String extractAgentReply(
+  List<String> lines,
+  String sentText, {
+  int maxChars = 1500,
+}) {
+  final start = _findAnchor(lines, sentText);
+  if (start < 0) return '';
+
+  final kept = <String>[];
+  var skippingToolOutput = false;
+  for (var i = start + 1; i < lines.length; i++) {
+    final raw = lines[i];
+    if (_isInputBoxStart(raw)) break;
+
+    final trimmed = raw.trim();
+    // Kết quả tool của Claude Code thụt vào sau "⎿"; bỏ cả khối đó.
+    if (trimmed.startsWith('⎿')) {
+      skippingToolOutput = true;
+      continue;
+    }
+    if (skippingToolOutput) {
+      if (trimmed.isEmpty) continue;
+      // Khối kết quả tool kết thúc khi gặp một mục mới ở đầu dòng.
+      if (_startsNewItem(trimmed)) {
+        skippingToolOutput = false;
+      } else {
+        continue;
+      }
+    }
+
+    final cleaned = _clean(raw);
+    if (cleaned == null) continue;
+    kept.add(cleaned);
+  }
+
+  var text = kept.join(' ').replaceAll(RegExp(r'\s+'), ' ').trim();
+  if (text.length > maxChars) {
+    final cut = text.lastIndexOf(RegExp(r'[.!?。]'), maxChars);
+    text = text.substring(0, cut > maxChars ~/ 2 ? cut + 1 : maxChars);
+  }
+  return text;
+}
+
+String _norm(String s) =>
+    s.toLowerCase().replaceAll(RegExp(r'\s+'), ' ').trim();
+
+/// Dòng cuối cùng chứa câu lệnh đã gửi. Chỉ so phần đầu câu, vì câu dài sẽ
+/// bị agent xuống dòng.
+int _findAnchor(List<String> lines, String sentText) {
+  final sent = _norm(sentText);
+  if (sent.isEmpty) return -1;
+  final probe = sent.length > 24 ? sent.substring(0, 24) : sent;
+  for (var i = lines.length - 1; i >= 0; i--) {
+    if (_norm(lines[i]).contains(probe)) return i;
+  }
+  return -1;
+}
+
+final _hRule = RegExp(r'^[\s─━═╌╍\-]{12,}$');
+
+/// Ô nhập liệu của agent: viền trên của khung (Claude Code), một đường kẻ
+/// ngang dài (Claude Code bản mới), hoặc dấu nhắc trống `>` / `›` (Codex).
+bool _isInputBoxStart(String line) {
+  final t = line.trim();
+  if (t.startsWith('╭')) return true;
+  if (_hRule.hasMatch(line) && t.isNotEmpty) return true;
+  if (t == '>' || t == '›' || t == '│ >' || t.startsWith('│ > ')) return true;
+  return false;
+}
+
+bool _startsNewItem(String trimmed) =>
+    trimmed.startsWith('⏺') ||
+    trimmed.startsWith('●') ||
+    trimmed.startsWith('•');
+
+final _spinner = RegExp(r'^[✻✽✶✳✢·*✦◐◓◑◒⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\s*\S+…');
+final _toolCall = RegExp(r'^[A-Z][A-Za-z]+\(.*\)\s*$');
+final _boxChars = RegExp(r'[│╭╮╰╯├┤┬┴┼║╔╗╚╝]');
+final _leadMarker = RegExp(r'^[⏺●•◦▪]\s*');
+final _noise = [
+  'esc to interrupt',
+  'to interrupt',
+  '? for shortcuts',
+  'ctrl+',
+  'shift+tab',
+  'auto-accept',
+  'context left',
+  'tokens',
+  'press enter',
+];
+
+String? _clean(String raw) {
+  var t = raw.replaceAll(_boxChars, ' ').trim();
+  if (t.isEmpty) return null;
+  final lower = t.toLowerCase();
+  for (final n in _noise) {
+    if (lower.contains(n)) return null;
+  }
+  if (_spinner.hasMatch(t)) return null;
+  t = t.replaceFirst(_leadMarker, '');
+  if (_toolCall.hasMatch(t)) return null;
+  // Codex ghi lại lệnh nó chạy, ví dụ "Ran ls -la" hoặc "$ ls".
+  if (t.startsWith(r'$ ') || t.startsWith('Ran ')) return null;
+  // Markdown đọc lên rất khó nghe.
+  t = t.replaceAll(RegExp(r'[`*_#]+'), '');
+  return t.trim().isEmpty ? null : t.trim();
+}
diff --git a/lib/core/voice/voice_engine.dart b/lib/core/voice/voice_engine.dart
new file mode 100644
index 0000000..2b97258
--- /dev/null
+++ b/lib/core/voice/voice_engine.dart
@@ -0,0 +1,112 @@
+import 'dart:async';
+
+import 'package:flutter_tts/flutter_tts.dart';
+import 'package:speech_to_text/speech_recognition_error.dart';
+import 'package:speech_to_text/speech_to_text.dart';
+
+/// Một nút micro duy nhất cho cả app: micro và loa của máy là tài nguyên
+/// dùng chung, hai terminal cùng nghe một lúc thì không có nghĩa.
+class VoiceEngine {
+  VoiceEngine._();
+  static final instance = VoiceEngine._();
+
+  final _stt = SpeechToText();
+  final _tts = FlutterTts();
+  bool _sttReady = false;
+  bool _ttsReady = false;
+
+  /// Gọi khi phiên nghe kết thúc vì lỗi hoặc vì người dùng ngừng nói.
+  void Function(String status)? onStatus;
+  void Function(String error)? onError;
+
+  bool get isListening => _stt.isListening;
+
+  Future<bool> _ensureStt() async {
+    if (_sttReady) return true;
+    _sttReady = await _stt.initialize(
+      onStatus: (s) => onStatus?.call(s),
+      onError: (SpeechRecognitionError e) => onError?.call(e.errorMsg),
+    );
+    return _sttReady;
+  }
+
+  Future<void> _ensureTts() async {
+    if (_ttsReady) return;
+    await _tts.awaitSpeakCompletion(true);
+    // iOS: sau khi thu âm, phiên âm thanh vẫn ở chế độ ghi âm và loa rất nhỏ.
+    // playAndRecord + defaultToSpeaker để đọc ra loa ngoài.
+    await _tts.setSharedInstance(true);
+    await _tts.setIosAudioCategory(
+      IosTextToSpeechAudioCategory.playAndRecord,
+      [
+        IosTextToSpeechAudioCategoryOptions.defaultToSpeaker,
+        IosTextToSpeechAudioCategoryOptions.allowBluetooth,
+        IosTextToSpeechAudioCategoryOptions.allowBluetoothA2DP,
+      ],
+      IosTextToSpeechAudioMode.defaultMode,
+    );
+    _ttsReady = true;
+  }
+
+  /// Bắt đầu nghe. [onWords] được gọi liên tục với câu đang nhận dạng,
+  /// `isFinal` = true khi người dùng ngừng nói.
+  ///
+  /// Trả về false nếu máy không có nhận dạng giọng nói hoặc bị từ chối quyền
+  /// micro.
+  Future<bool> listen({
+    required String locale,
+    required void Function(String words, bool isFinal) onWords,
+    Duration pauseFor = const Duration(seconds: 3),
+  }) async {
+    if (!await _ensureStt()) return false;
+    await _tts.stop();
+    await _stt.listen(
+      onResult: (r) => onWords(r.recognizedWords, r.finalResult),
+      // speech_to_text dùng dạng vi_VN, TTS dùng vi-VN.
+      // ignore: deprecated_member_use
+      localeId: locale.replaceAll('-', '_'),
+      listenFor: const Duration(minutes: 2),
+      pauseFor: pauseFor,
+      listenOptions: SpeechListenOptions(
+        partialResults: true,
+        cancelOnError: true,
+        listenMode: ListenMode.dictation,
+        autoPunctuation: true,
+      ),
+    );
+    return true;
+  }
+
+  Future<void> stopListening() => _stt.stop();
+  Future<void> cancelListening() => _stt.cancel();
+
+  /// Đọc [text], chờ đến khi đọc xong.
+  Future<void> speak(String text, {required String locale, double rate = 0.5}) async {
+    if (text.trim().isEmpty) return;
+    await _ensureTts();
+    await _tts.setLanguage(locale);
+    await _tts.setSpeechRate(rate);
+    await _tts.speak(text);
+  }
+
+  Future<void> stopSpeaking() => _tts.stop();
+}
+
+/// Câu nói ngắn được hiểu là một phím, không phải tin nhắn cho agent.
+/// Chỉ khớp khi cả câu đúng bằng khẩu lệnh, để "đồng ý với cách làm đó nhưng
+/// sửa lại tên hàm" vẫn được gửi nguyên văn.
+enum VoiceKeyword { enter, escape, interrupt }
+
+VoiceKeyword? matchVoiceKeyword(String words) {
+  final w = words.toLowerCase().replaceAll(RegExp(r'[.,!?]'), '').trim();
+  const enter = {
+    'đồng ý', 'ok', 'okay', 'oke', 'xác nhận', 'được', 'có', 'yes', 'enter',
+    'gửi', 'chấp nhận',
+  };
+  const escape = {'từ chối', 'không', 'no', 'thoát', 'escape', 'hủy', 'huỷ'};
+  const interrupt = {'dừng lại', 'dừng', 'stop', 'ngắt'};
+  if (enter.contains(w)) return VoiceKeyword.enter;
+  if (escape.contains(w)) return VoiceKeyword.escape;
+  if (interrupt.contains(w)) return VoiceKeyword.interrupt;
+  return null;
+}
