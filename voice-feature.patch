diff --git a/lib/view/widget/voice_terminal_button.dart b/lib/view/widget/voice_terminal_button.dart
new file mode 100644
index 0000000..d0aa1e8
--- /dev/null
+++ b/lib/view/widget/voice_terminal_button.dart
@@ -0,0 +1,393 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:server_box/core/voice/reply_extractor.dart';
+import 'package:server_box/core/voice/voice_engine.dart';
+import 'package:server_box/data/res/store.dart';
+import 'package:xterm/core.dart';
+
+enum _Phase { idle, listening, waiting, speaking }
+
+/// Nút micro nổi trên terminal.
+///
+/// - Chạm: bắt đầu nghe. Chạm lần nữa khi đang nghe: gửi ngay.
+/// - Chạm khi đang chờ/đang đọc: dừng.
+/// - Nhấn giữ: mở cài đặt giọng nói.
+///
+/// Câu nói được dán vào terminal (bracketed paste nếu chương trình hỗ trợ,
+/// như Claude Code và Codex), rồi nhấn Enter nếu bật tự gửi.
+class VoiceTerminalButton extends StatefulWidget {
+  const VoiceTerminalButton({super.key, required this.terminal});
+
+  final Terminal terminal;
+
+  @override
+  State<VoiceTerminalButton> createState() => _VoiceTerminalButtonState();
+}
+
+class _VoiceTerminalButtonState extends State<VoiceTerminalButton> {
+  final _engine = VoiceEngine.instance;
+  final _s = Stores.setting;
+
+  _Phase _phase = _Phase.idle;
+  String _words = '';
+  String? _hint;
+
+  /// Tăng mỗi lần terminal vẽ lại, để biết màn hình đã đứng yên chưa.
+  int _screenVersion = 0;
+  Timer? _settleTimer;
+  String _lastSent = '';
+  bool _submitting = false;
+
+  @override
+  void initState() {
+    super.initState();
+    widget.terminal.addListener(_onTerminalChanged);
+  }
+
+  @override
+  void dispose() {
+    widget.terminal.removeListener(_onTerminalChanged);
+    _settleTimer?.cancel();
+    if (_phase == _Phase.listening) unawaited(_engine.cancelListening());
+    if (_phase == _Phase.speaking) unawaited(_engine.stopSpeaking());
+    super.dispose();
+  }
+
+  void _onTerminalChanged() => _screenVersion++;
+
+  void _setPhase(_Phase p, {String? hint}) {
+    if (!mounted) return;
+    setState(() {
+      _phase = p;
+      _hint = hint;
+      if (p != _Phase.listening) _words = '';
+    });
+  }
+
+  // ---------------------------------------------------------------- nghe
+
+  Future<void> _startListening() async {
+    HapticFeedback.mediumImpact();
+    _words = '';
+    _engine.onError = (e) {
+      if (_phase == _Phase.listening) {
+        _setPhase(_Phase.idle, hint: 'Lỗi micro: $e');
+      }
+    };
+    // Micro tự tắt (hết thời gian, im lặng) mà không có kết quả cuối: gửi
+    // những gì đã nghe được, hoặc quay về trạng thái chờ nếu chưa nghe gì.
+    _engine.onStatus = (status) {
+      if (status != 'done' && status != 'notListening') return;
+      Future.delayed(const Duration(milliseconds: 600), () {
+        if (mounted && _phase == _Phase.listening && !_submitting) {
+          unawaited(_submit(_words));
+        }
+      });
+    };
+    final ok = await _engine.listen(
+      locale: _s.voiceLocale.fetch(),
+      onWords: (words, isFinal) {
+        if (!mounted) return;
+        setState(() => _words = words);
+        if (isFinal) unawaited(_submit(words));
+      },
+    );
+    if (!ok) {
+      _setPhase(
+        _Phase.idle,
+        hint: 'Không dùng được nhận dạng giọng nói. Kiểm tra quyền micro.',
+      );
+      return;
+    }
+    _setPhase(_Phase.listening);
+  }
+
+  Future<void> _submit(String words) async {
+    if (_phase != _Phase.listening || _submitting) return;
+    _submitting = true;
+    try {
+      await _submitInner(words);
+    } finally {
+      _submitting = false;
+    }
+  }
+
+  Future<void> _submitInner(String words) async {
+    await _engine.stopListening();
+    final text = words.trim();
+    if (text.isEmpty) {
+      _setPhase(_Phase.idle, hint: 'Không nghe thấy gì.');
+      return;
+    }
+
+    if (_s.voiceKeywords.fetch()) {
+      switch (matchVoiceKeyword(text)) {
+        case VoiceKeyword.enter:
+          widget.terminal.keyInput(TerminalKey.enter);
+          return _afterSend(text, expectReply: true);
+        case VoiceKeyword.escape:
+        case VoiceKeyword.interrupt:
+          widget.terminal.keyInput(TerminalKey.escape);
+          return _setPhase(_Phase.idle, hint: 'Đã gửi Esc');
+        case null:
+          break;
+      }
+    }
+
+    widget.terminal.paste(text);
+    if (!_s.voiceAutoEnter.fetch()) {
+      _setPhase(_Phase.idle, hint: 'Đã dán, nhấn Enter để gửi');
+      return;
+    }
+    // Chờ một chút để chương trình nhận hết phần dán rồi mới Enter; gửi liền
+    // thì có agent coi Enter là một phần của đoạn dán.
+    await Future.delayed(const Duration(milliseconds: 150));
+    widget.terminal.keyInput(TerminalKey.enter);
+    _lastSent = text;
+    await _afterSend(text, expectReply: true);
+  }
+
+  // ------------------------------------------------------------ chờ trả lời
+
+  Future<void> _afterSend(String text, {required bool expectReply}) async {
+    if (!expectReply || !_s.voiceSpeakReply.fetch()) {
+      _setPhase(_Phase.idle);
+      return;
+    }
+    _setPhase(_Phase.waiting);
+    _waitForReply();
+  }
+
+  /// Màn hình đứng yên 2,5 giây và agent không còn "esc to interrupt" thì coi
+  /// như đã trả lời xong. Tối đa 15 phút.
+  void _waitForReply() {
+    _settleTimer?.cancel();
+    final started = DateTime.now();
+    var lastVersion = _screenVersion;
+    var stableSince = DateTime.now();
+
+    _settleTimer = Timer.periodic(const Duration(milliseconds: 400), (t) {
+      if (!mounted || _phase != _Phase.waiting) return t.cancel();
+      final now = DateTime.now();
+      if (now.difference(started) > const Duration(minutes: 15)) {
+        t.cancel();
+        return _setPhase(_Phase.idle, hint: 'Hết thời gian chờ');
+      }
+      if (_screenVersion != lastVersion) {
+        lastVersion = _screenVersion;
+        stableSince = now;
+        return;
+      }
+      if (now.difference(started) < const Duration(milliseconds: 1500)) return;
+      if (now.difference(stableSince) < const Duration(milliseconds: 2500)) {
+        return;
+      }
+      final lines = _screenLines();
+      final tail = lines.length > 15 ? lines.sublist(lines.length - 15) : lines;
+      if (agentLooksBusy(tail)) return;
+
+      t.cancel();
+      unawaited(_speakReply(lines));
+    });
+  }
+
+  /// Các dòng logic của màn hình: dòng bị xuống dòng tự động được nối lại.
+  List<String> _screenLines() {
+    final out = <String>[];
+    for (final line in widget.terminal.buffer.lines.toList()) {
+      final text = line.getText();
+      if (line.isWrapped && out.isNotEmpty) {
+        out[out.length - 1] = out.last + text;
+      } else {
+        out.add(text);
+      }
+    }
+    return out;
+  }
+
+  Future<void> _speakReply(List<String> lines) async {
+    final reply = extractAgentReply(lines, _lastSent);
+    if (reply.isEmpty) {
+      _setPhase(_Phase.idle, hint: 'Không tìm thấy câu trả lời để đọc');
+      return;
+    }
+    _setPhase(_Phase.speaking);
+    await _engine.speak(
+      reply,
+      locale: _s.voiceLocale.fetch(),
+      rate: _s.voiceSpeechRate.fetch(),
+    );
+    if (!mounted || _phase != _Phase.speaking) return;
+    if (_s.voiceConversation.fetch()) {
+      await _startListening();
+    } else {
+      _setPhase(_Phase.idle);
+    }
+  }
+
+  // -------------------------------------------------------------- nút bấm
+
+  Future<void> _onTap() async {
+    switch (_phase) {
+      case _Phase.idle:
+        await _startListening();
+      case _Phase.listening:
+        await _submit(_words);
+      case _Phase.waiting:
+        _settleTimer?.cancel();
+        _setPhase(_Phase.idle);
+      case _Phase.speaking:
+        await _engine.stopSpeaking();
+        _setPhase(_Phase.idle);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    final (icon, color) = switch (_phase) {
+      _Phase.idle => (Icons.mic_none, scheme.primaryContainer),
+      _Phase.listening => (Icons.mic, scheme.errorContainer),
+      _Phase.waiting => (Icons.hourglass_top, scheme.secondaryContainer),
+      _Phase.speaking => (Icons.volume_up, scheme.tertiaryContainer),
+    };
+    final label = switch (_phase) {
+      _Phase.listening => _words.isEmpty ? 'Đang nghe…' : _words,
+      _Phase.waiting => 'Đang chờ agent trả lời… (chạm để bỏ)',
+      _Phase.speaking => 'Đang đọc… (chạm để dừng)',
+      _Phase.idle => _hint,
+    };
+
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.end,
+      children: [
+        if (label != null && label.isNotEmpty)
+          ConstrainedBox(
+            constraints: const BoxConstraints(maxWidth: 280),
+            child: Card(
+              margin: const EdgeInsets.only(bottom: 8),
+              child: Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+                child: Text(label, maxLines: 4, overflow: TextOverflow.ellipsis),
+              ),
+            ),
+          ),
+        GestureDetector(
+          onLongPress: () => showVoiceSettingsSheet(context),
+          child: FloatingActionButton.small(
+            heroTag: null,
+            backgroundColor: color,
+            tooltip: 'Giọng nói (giữ để cài đặt)',
+            onPressed: _onTap,
+            child: Icon(icon),
+          ),
+        ),
+      ],
+    );
+  }
+}
+
+/// Bảng cài đặt giọng nói. Mở bằng cách nhấn giữ nút micro.
+Future<void> showVoiceSettingsSheet(BuildContext context) {
+  final s = Stores.setting;
+  return showModalBottomSheet<void>(
+    context: context,
+    showDragHandle: true,
+    isScrollControlled: true,
+    builder: (context) => StatefulBuilder(
+      builder: (context, setState) {
+        Widget toggle(
+          String title,
+          String sub,
+          bool Function() get,
+          void Function(bool) put,
+        ) => SwitchListTile(
+          title: Text(title),
+          subtitle: Text(sub),
+          value: get(),
+          onChanged: (v) {
+            put(v);
+            setState(() {});
+          },
+        );
+        final locale = s.voiceLocale.fetch();
+        final rate = s.voiceSpeechRate.fetch();
+        return SafeArea(
+          child: SingleChildScrollView(
+            child: Column(
+              mainAxisSize: MainAxisSize.min,
+              children: [
+                const ListTile(
+                  title: Text(
+                    'Giọng nói',
+                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.w600),
+                  ),
+                ),
+                toggle(
+                  'Tự gửi (Enter)',
+                  'Tắt để xem lại câu trước khi gửi',
+                  s.voiceAutoEnter.fetch,
+                  s.voiceAutoEnter.put,
+                ),
+                toggle(
+                  'Đọc câu trả lời',
+                  'Đọc thành tiếng khi Claude Code / Codex làm xong',
+                  s.voiceSpeakReply.fetch,
+                  s.voiceSpeakReply.put,
+                ),
+                toggle(
+                  'Chế độ hội thoại',
+                  'Đọc xong tự nghe tiếp, rảnh tay hoàn toàn',
+                  s.voiceConversation.fetch,
+                  s.voiceConversation.put,
+                ),
+                toggle(
+                  'Khẩu lệnh',
+                  '"đồng ý" = Enter, "từ chối" / "dừng lại" = Esc',
+                  s.voiceKeywords.fetch,
+                  s.voiceKeywords.put,
+                ),
+                ListTile(
+                  title: const Text('Ngôn ngữ'),
+                  trailing: SegmentedButton<String>(
+                    segments: const [
+                      ButtonSegment(value: 'vi-VN', label: Text('Tiếng Việt')),
+                      ButtonSegment(value: 'en-US', label: Text('English')),
+                    ],
+                    selected: {locale},
+                    onSelectionChanged: (v) {
+                      s.voiceLocale.put(v.first);
+                      setState(() {});
+                    },
+                  ),
+                ),
+                ListTile(
+                  title: Text('Tốc độ đọc: ${rate.toStringAsFixed(1)}'),
+                  subtitle: Slider(
+                    value: rate,
+                    min: 0.1,
+                    max: 1.0,
+                    divisions: 9,
+                    onChanged: (v) {
+                      s.voiceSpeechRate.put(v);
+                      setState(() {});
+                    },
+                  ),
+                ),
+                toggle(
+                  'Hiện nút micro',
+                  'Tắt hẳn tính năng (mở lại trong Cài đặt của app)',
+                  s.voiceEnabled.fetch,
+                  s.voiceEnabled.put,
+                ),
+              ],
+            ),
+          ),
+        );
+      },
+    ),
+  );
+}
