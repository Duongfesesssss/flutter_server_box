@@ -0,0 +1,62 @@
+import 'package:server_box/core/voice/reply_extractor.dart';
+import 'package:test/test.dart';
+
+void main() {
+  group('extractAgentReply', () {
+    test('Claude Code: lấy câu trả lời, bỏ tool call và kết quả tool', () {
+      const screen = [
+        '> sửa lỗi build trong file main',
+        '',
+        '⏺ Mình sẽ xem file main trước.',
+        '',
+        '⏺ Read(lib/main.dart)',
+        '  ⎿  Read 120 lines (ctrl+r to expand)',
+        '     import foo',
+        '',
+        '⏺ Đã sửa xong. Lỗi do thiếu dấu chấm phẩy ở dòng 42.',
+        '',
+        '╭──────────────────────────────────────────────╮',
+        '│ >                                            │',
+        '╰──────────────────────────────────────────────╯',
+        '  ? for shortcuts',
+      ];
+      expect(
+        extractAgentReply(screen, 'sửa lỗi build trong file main'),
+        'Mình sẽ xem file main trước. Đã sửa xong. Lỗi do thiếu dấu chấm phẩy ở dòng 42.',
+      );
+    });
+
+    test('Codex: dấu nhắc › và ô nhập kiểu đường kẻ', () {
+      const screen = [
+        '› liệt kê các file',
+        '',
+        '• Ran ls',
+        '• Thư mục có 3 file: a.txt, b.txt và **c.txt**.',
+        '',
+        '────────────────────────────────────────',
+        '›',
+      ];
+      expect(
+        extractAgentReply(screen, 'liệt kê các file'),
+        'Thư mục có 3 file: a.txt, b.txt và c.txt.',
+      );
+    });
+
+    test('không thấy câu đã gửi thì trả về rỗng', () {
+      expect(extractAgentReply(const ['abc'], 'xyz'), '');
+    });
+
+    test('cắt ở cuối câu khi quá dài', () {
+      final long = List.filled(50, 'Câu này dài.').join(' ');
+      final out = extractAgentReply(['> hỏi', long], 'hỏi', maxChars: 100);
+      expect(out.length, lessThanOrEqualTo(100));
+      expect(out.endsWith('.'), isTrue);
+    });
+  });
+
+  test('agentLooksBusy', () {
+    expect(agentLooksBusy(const ['✻ Thinking… (esc to interrupt)']), isTrue);
+    expect(agentLooksBusy(const ['Working (5s • Esc to interrupt)']), isTrue);
+    expect(agentLooksBusy(const ['> ']), isFalse);
+  });
+}
